#!/usr/bin/env python3
"""
fleet-setup
Interactive Setup & Bootstrap Wizard for Omarchy Fleet Security Plugin.
Configures FleetDM server connectivity, credentials, and verifies telemetry.
"""

import getpass
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

# Colors
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
CYAN = "\033[36m"
MAGENTA = "\033[35m"

PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONFIG_PATH = os.path.join(PLUGIN_DIR, "config.json")
FLEET_CONFIG = os.path.expanduser("~/.fleet/config")
DEMO_FLAG = os.path.expanduser("~/.config/omarchy/fleet_demo_active")


def clear_screen():
    print("\033[2J\033[H", end="")


def header():
    print(f"{BOLD}{CYAN}================================================================{RESET}")
    print(f"{BOLD} 󰓠 Omarchy Fleet Security — Setup & Bootstrap Wizard{RESET}")
    print(f"{BOLD}{CYAN}================================================================{RESET}\n")


def prompt_input(prompt_text: str, default: str = "") -> str:
    """Safe input helper handling EOF and KeyboardInterrupt."""
    try:
        val = input(prompt_text).strip()
        return val if val else default
    except (EOFError, KeyboardInterrupt):
        print("")
        return default


def wait_enter(prompt_text: str = ""):
    """Safe press-enter helper, no-op if stdin is not a TTY."""
    if not sys.stdin.isatty():
        return
    try:
        input(prompt_text or f"\n{DIM}Press Enter to exit...{RESET}")
    except (EOFError, KeyboardInterrupt):
        print("")


def get_default_url() -> str:
    # 1. Existing ~/.fleet/config
    if os.path.isfile(FLEET_CONFIG):
        try:
            with open(FLEET_CONFIG, "r") as f:
                for line in f:
                    if "address:" in line:
                        addr = line.split("address:", 1)[1].strip()
                        if addr:
                            return addr
        except Exception:
            pass

    # 2. Existing config.json
    if os.path.isfile(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r") as f:
                cfg = json.load(f)
                if cfg.get("fleet_url"):
                    return cfg["fleet_url"].strip()
        except Exception:
            pass

    # 3. Tailscale discovery
    if shutil.which("tailscale"):
        try:
            ts_ip = subprocess.check_output(["tailscale", "ip", "-4"], text=True, stderr=subprocess.DEVNULL).strip().splitlines()[0]
            if ts_ip:
                return f"https://{ts_ip}:8080"
        except Exception:
            pass

    return "https://localhost:8080"


def check_fleetctl() -> bool:
    if not shutil.which("fleetctl"):
        print(f"{RED}{BOLD}Error: 'fleetctl' CLI was not found in your PATH.{RESET}")
        print("\nFleet Security requires 'fleetctl' to query your FleetDM instance.")
        print("\nInstallation instructions:")
        print(f"  • {BOLD}Arch Linux / Manjaro:{RESET} yay -S fleetctl-bin")
        print(f"  • {BOLD}macOS:{RESET}                brew install fleetctl")
        print(f"  • {BOLD}Direct Download:{RESET}      https://github.com/fleetdm/fleet/releases\n")
        
        choice = prompt_input(f"Would you like to switch to {BOLD}Simulated Demo Mode{RESET} instead? [Y/n]: ", default="y").lower()
        if choice in ("", "y", "yes"):
            enable_demo_mode(interactive=True)
            sys.exit(0)
        else:
            print(f"\nPlease install 'fleetctl' and re-run {BOLD}fleet-setup{RESET}.")
            wait_enter()
            sys.exit(1)
    return True


def enable_demo_mode(interactive: bool = False):
    try:
        os.makedirs(os.path.dirname(DEMO_FLAG), exist_ok=True)
        open(DEMO_FLAG, "w").close()
    except Exception:
        pass
    print(f"\n{GREEN}✓ Demo Mode enabled!{RESET}")
    print("The widget will display simulated multi-host telemetry and vulnerabilities.")
    trigger_refresh()
    if interactive and sys.stdin.isatty():
        try:
            input(f"\n{DIM}Press Enter to exit...{RESET}")
        except Exception:
            pass


def disable_demo_mode():
    if os.path.exists(DEMO_FLAG):
        try:
            os.remove(DEMO_FLAG)
        except Exception:
            pass


def trigger_refresh():
    cache_file = os.path.expanduser("~/.cache/omarchy-fleet/status.json")
    if os.path.exists(cache_file):
        try:
            os.remove(cache_file)
        except Exception:
            pass
    if shutil.which("omarchy-shell"):
        try:
            subprocess.run(["omarchy-shell", "jellespijker.fleet", "refresh"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass


def test_connection() -> tuple[bool, str, int, int]:
    """Tests fleetctl connection. Returns (success, error_msg, hosts_total, hosts_online)."""
    try:
        proc = subprocess.run(
            ["fleetctl", "get", "hosts", "--json"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10
        )
        if proc.returncode == 0:
            total = 0
            online = 0
            for line in proc.stdout.strip().splitlines():
                if not line.strip():
                    continue
                try:
                    h = json.loads(line)
                    spec = h.get("spec", h)
                    total += 1
                    if spec.get("status", "").lower() == "online":
                        online += 1
                except Exception:
                    pass
            return True, "", total, online
        return False, proc.stderr.strip(), 0, 0
    except subprocess.TimeoutExpired:
        return False, "Connection timed out (server did not respond in 10s)", 0, 0
    except Exception as e:
        return False, str(e), 0, 0


def save_plugin_config(fleet_url: str):
    data = {
        "fleet_url": fleet_url,
        "refresh_interval_sec": 60,
        "terminal_cmd": "omarchy-launch-floating-terminal-with-presentation"
    }
    try:
        os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
        with open(CONFIG_PATH, "w") as f:
            json.dump(data, f, indent=2)
    except Exception as e:
        print(f"{YELLOW}Warning: Failed to save config.json: {e}{RESET}")


def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        print("""Usage: fleet-setup [options]

Interactive Setup & Bootstrap Wizard for the Omarchy Fleet Security Plugin.

Options:
  --demo      Directly enable synthetic demonstration mode and exit
  --live      Directly disable demonstration mode (use live fleet) and exit
  -h, --help  Show this help message and exit
""")
        return

    if "--demo" in sys.argv:
        enable_demo_mode()
        save_plugin_config(get_default_url())
        trigger_refresh()
        print(f"{GREEN}✓ Demo mode enabled successfully.{RESET}")
        return

    if "--live" in sys.argv:
        disable_demo_mode()
        save_plugin_config(get_default_url())
        trigger_refresh()
        print(f"{GREEN}✓ Live mode enabled.{RESET}")
        return

    clear_screen()
    header()
    check_fleetctl()

    # Check current status
    print(f"{BOLD}[1/4] Checking Current FleetDM Connection...{RESET}")
    success, err, total, online = test_connection()
    if success:
        print(f"  {GREEN}✓ Already connected to Fleet!{RESET}")
        print(f"  Found {BOLD}{total}{RESET} hosts ({BOLD}{online}{RESET} online).\n")
        print(f"Configured address: {CYAN}{get_default_url()}{RESET}\n")
        print("What would you like to do?")
        print(f"  {BOLD}1{RESET}) Keep current connection and refresh widget")
        print(f"  {BOLD}2{RESET}) Reconfigure server address or credentials")
        print(f"  {BOLD}3{RESET}) Switch to Simulated Demo Mode")
        print(f"  {BOLD}4{RESET}) Exit")
        choice = prompt_input(f"\nEnter choice [1-4, default: 1]: ", default="1")
        if choice in ("", "1"):
            disable_demo_mode()
            trigger_refresh()
            print(f"\n{GREEN}✓ Fleet Security widget refreshed!{RESET}")
            wait_enter()
            return
        elif choice == "3":
            enable_demo_mode(interactive=True)
            return
        elif choice == "4":
            return

    else:
        print(f"  {YELLOW}• Status:{RESET} Not currently connected to a Fleet instance.")
        if err:
            first_err = err.splitlines()[0] if err else ""
            print(f"    {DIM}Reason: {first_err}{RESET}")

    # Server URL Prompt
    print(f"\n{BOLD}[2/4] Configure Fleet Server URL{RESET}")
    default_url = get_default_url()
    user_url = prompt_input(f"Enter your Fleet server address [default: {CYAN}{default_url}{RESET}]: ", default=default_url)
    fleet_url = user_url if user_url else default_url
    if not fleet_url.startswith("http://") and not fleet_url.startswith("https://"):
        fleet_url = "https://" + fleet_url

    # TLS skip verify check
    tls_skip = False
    insecure_choice = prompt_input(f"Does this server use a self-signed or custom TLS certificate? [y/N]: ", default="n").lower()
    if insecure_choice in ("y", "yes"):
        tls_skip = True

    # Set address in fleetctl
    cmd = ["fleetctl", "config", "set", "--address", fleet_url]
    if tls_skip:
        cmd.append("--tls-skip-verify")
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"  {GREEN}✓{RESET} Set Fleet address: {CYAN}{fleet_url}{RESET}")

    # Authentication Choice
    print(f"\n{BOLD}[3/4] Choose Authentication Method{RESET}")
    print(f"  {BOLD}1{RESET}) {GREEN}Fleet API Token{RESET} (Recommended — long-lived, works with SSO & 2FA)")
    print(f"  {BOLD}2{RESET}) {CYAN}Email & Password{RESET} (Interactive fleetctl login)")
    print(f"  {BOLD}3{RESET}) {MAGENTA}Simulated Demo Mode{RESET} (No credentials needed)")
    
    auth_choice = prompt_input(f"\nEnter choice [1-3, default: 1]: ", default="1")

    if auth_choice == "3":
        enable_demo_mode(interactive=True)
        save_plugin_config(fleet_url)
        return

    elif auth_choice == "2":
        print(f"\nLaunching {BOLD}fleetctl login{RESET}...")
        res = subprocess.run(["fleetctl", "login"])
        if res.returncode != 0:
            print(f"\n{RED}Login failed. Please check credentials and try again.{RESET}")
            wait_enter()
            return

    else:
        print(f"\n{BOLD}How to find your Fleet API Token:{RESET}")
        print(f"  1. Open Fleet in your browser: {CYAN}{fleet_url}{RESET}")
        print(f"  2. Click your avatar (top right) -> {BOLD}My account{RESET}")
        print(f"  3. Click {BOLD}Get API token{RESET} and copy the token")
        print("")
        try:
            token = getpass.getpass("Paste your Fleet API Token (hidden): ").strip()
        except (EOFError, KeyboardInterrupt):
            print("")
            return
        if not token:
            print(f"{RED}Error: Token cannot be empty.{RESET}")
            wait_enter()
            return

        env = dict(os.environ, TOKEN=token)
        subprocess.run(["fleetctl", "config", "set"], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.isfile(FLEET_CONFIG):
            try:
                os.chmod(FLEET_CONFIG, 0o600)
            except Exception:
                pass
        print(f"  {GREEN}✓{RESET} Token saved to ~/.fleet/config (permissions 0600)")

    # Step 4: Verification
    print(f"\n{BOLD}[4/4] Verifying Fleet Telemetry Connection...{RESET}")
    success, err, total, online = test_connection()
    if success:
        disable_demo_mode()
        save_plugin_config(fleet_url)
        trigger_refresh()
        print(f"\n{BOLD}{GREEN}================================================================{RESET}")
        print(f"{BOLD}{GREEN} ✓ Successfully Connected to FleetDM!{RESET}")
        print(f"{BOLD}{GREEN}================================================================{RESET}")
        print(f"• Monitored Hosts: {BOLD}{total}{RESET} ({BOLD}{online}{RESET} online)")
        print(f"• Fleet Server:    {CYAN}{fleet_url}{RESET}")
        print(f"• Status Bar:      Widget updated with live vulnerability telemetry.\n")
    else:
        print(f"\n{RED}{BOLD}Connection Test Failed:{RESET}")
        print(f"{RED}{err}{RESET}\n")
        print("Troubleshooting suggestions:")
        print("  • If using self-signed certs, re-run and answer 'y' to TLS skip verify.")
        print("  • Ensure the Fleet server is reachable from this network.")
        print("  • If using Tailscale, ensure Tailscale is connected (`tailscale up`).")
        retry = prompt_input(f"\nWould you like to enable Demo Mode for now? [Y/n]: ", default="y").lower()
        if retry in ("", "y", "yes"):
            enable_demo_mode(interactive=True)
            save_plugin_config(fleet_url)

    wait_enter(f"{DIM}Press Enter to close setup...{RESET}\n")


if __name__ == "__main__":
    main()
